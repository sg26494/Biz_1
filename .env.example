# Copy to .env and fill in. Never commit .env.

# --- Database (managed Postgres in prod) ---
DB_URL=jdbc:postgresql://localhost:5432/store
DB_USER=store
DB_PASSWORD=store

# --- Security ---
# 32+ random bytes, e.g. `openssl rand -base64 48`
JWT_SECRET=change-me-change-me-change-me-change-me-change-me-0123456789
OTP_PEPPER=change-me-otp-pepper
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000
# Comma-separated; these become ADMIN on API startup (the 4 founders)
ADMIN_SEED_EMAILS=

# --- Google Sign-In (OAuth client, type "Web application") ---
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Email: smtp (Mailpit locally / SES SMTP in prod) or resend ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=Your Store <orders@example.com>
ADMIN_ALERT_EMAILS=
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
RESEND_API_KEY=

# --- Razorpay (test keys on staging) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- Shiprocket (phase 6; false uses a stub that accepts every pincode) ---
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=

# --- Object storage (MinIO locally, Cloudflare R2 or S3 in prod) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=us-east-1
STORAGE_BUCKET=store-media
STORAGE_ACCESS_KEY=minio
STORAGE_SECRET_KEY=minio12345
STORAGE_PUBLIC_BASE_URL=http://localhost:9000/store-media
STORAGE_PATH_STYLE=true

# --- Frontend ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Your Store
REVALIDATE_SECRET=dev-revalidate-secret
