# Where the Next.js server reaches Spring Boot (server-side fetches + dev rewrite)
API_INTERNAL_URL=http://localhost:8080
# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=Gulmohar Fabrics
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Must match REVALIDATE_SECRET on the API
REVALIDATE_SECRET=dev-revalidate-secret
